{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/trip-handbook/plan.schema.json",
  "title": "Trip Handbook Plan",
  "type": "object",
  "required": [
    "trip",
    "travelers",
    "transport",
    "stays",
    "cities",
    "days",
    "places",
    "food_groups",
    "checklists"
  ],
  "properties": {
    "trip": {
      "type": "object",
      "required": [
        "title",
        "start_date",
        "end_date",
        "days",
        "nights",
        "origin",
        "rhythm",
        "wake_time",
        "sleep_time"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "start_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "end_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "days": {
          "type": "integer",
          "minimum": 1,
          "description": "自然日数（含返程日），等于 start_date 至 end_date 的闭区间天数；行程数组 days[] 的长度必须等于它"
        },
        "nights": {
          "type": "integer",
          "minimum": 1,
          "description": "总晚数，等于 cities[]/stays[] 各城晚数之和"
        },
        "origin": {
          "type": "string"
        },
        "rhythm": {
          "enum": [
            "slow-food",
            "sightseeing",
            "culture",
            "balanced"
          ]
        },
        "wake_time": {
          "type": "string"
        },
        "sleep_time": {
          "type": "string"
        }
      }
    },
    "travelers": {
      "type": "object",
      "required": [
        "count",
        "groups",
        "rooms_per_night"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "groups": {
          "type": "string"
        },
        "rooms_per_night": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "transport": {
      "type": "object",
      "required": [
        "status",
        "legs"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "confirmed"
          ]
        },
        "legs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "mode",
              "date",
              "status"
            ],
            "properties": {
              "mode": {
                "type": "string",
                "description": "出行方式；组合用 + 连接，如 high-speed-rail+flight",
                "anyOf": [
                  {
                    "enum": [
                      "flight",
                      "high-speed-rail",
                      "intercity-rail",
                      "normal-rail",
                      "drive",
                      "coach"
                    ]
                  },
                  {
                    "pattern": "^(flight|high-speed-rail|intercity-rail|normal-rail|drive|coach)(\\+(flight|high-speed-rail|intercity-rail|normal-rail|drive|coach))+$"
                  }
                ]
              },
              "date": {
                "type": "string"
              },
              "departure": {
                "type": "object"
              },
              "arrival": {
                "type": "object"
              },
              "status": {
                "enum": [
                  "pending",
                  "confirmed"
                ]
              },
              "note": {
                "type": "string"
              }
            }
          }
        },
        "preference": {
          "type": "string",
          "enum": [
            "any",
            "prefer-rail",
            "prefer-flight",
            "prefer-drive",
            "allow-combo",
            "rail-only",
            "flight-only"
          ],
          "description": "问卷「出行倾向」第一层。any=不限（哪种划算选哪种）"
        },
        "profile": {
          "type": "string",
          "enum": [
            "thrifty",
            "balanced",
            "comfort"
          ],
          "description": "比价口径。thrifty=省钱优先（现阶段默认）/ balanced=均衡 / comfort=舒适优先"
        },
        "recommendation": {
          "type": [
            "object",
            "null"
          ],
          "description": "由 scripts/transport.py 产出的比价结果（含可解释的评分明细）；无价表数据时为 null",
          "properties": {
            "profile": {
              "type": "string",
              "enum": [
                "thrifty",
                "balanced",
                "comfort"
              ]
            },
            "profile_label": {
              "type": "string"
            },
            "profile_note": {
              "type": "string"
            },
            "recommended": {
              "type": [
                "object",
                "null"
              ],
              "properties": {
                "mode": {
                  "type": "string"
                },
                "mode_label": {
                  "type": "string"
                },
                "score": {
                  "type": "number"
                },
                "breakdown": {
                  "type": "string"
                },
                "total_hours": {
                  "type": "number"
                },
                "source_note": {
                  "type": "string"
                }
              }
            },
            "alternatives": {
              "type": "array"
            },
            "excluded": {
              "type": "array"
            },
            "insufficient_data": {
              "type": "boolean"
            },
            "needs_fields": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "stays": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "city",
          "nights",
          "area",
          "status"
        ],
        "properties": {
          "city": {
            "type": "string"
          },
          "nights": {
            "type": "integer",
            "minimum": 1
          },
          "area": {
            "type": "string"
          },
          "status": {
            "enum": [
              "pending",
              "confirmed",
              "recommended"
            ]
          },
          "reason": {
            "type": "string"
          },
          "hotels": {
            "type": "array"
          }
        }
      }
    },
    "cities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "city",
          "nights"
        ],
        "properties": {
          "city": {
            "type": "string"
          },
          "nights": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "days": {
      "type": "array",
      "description": "逐日行程；长度必须等于 trip.days（自然日、含返程日）",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "date",
          "city",
          "theme",
          "summary",
          "periods",
          "stops"
        ],
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "city": {
            "type": "string"
          },
          "theme": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "periods": {
            "type": "object",
            "required": [
              "morning",
              "afternoon",
              "evening"
            ],
            "properties": {
              "morning": {
                "type": "string"
              },
              "afternoon": {
                "type": "string"
              },
              "evening": {
                "type": "string"
              }
            }
          },
          "stops": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": [
                "place_id",
                "time",
                "dwell_minutes",
                "transport_mode",
                "transfer_minutes",
                "estimated_cost",
                "practical_note",
                "time_guard"
              ],
              "properties": {
                "place_id": {
                  "type": "string"
                },
                "time": {
                  "type": "string"
                },
                "dwell_minutes": {
                  "type": "integer",
                  "minimum": 0
                },
                "transport_mode": {
                  "type": "string"
                },
                "transfer_minutes": {
                  "type": "integer",
                  "minimum": 0
                },
                "distance_km": {
                  "type": "number",
                  "minimum": 0
                },
                "estimated_cost": {
                  "type": [
                    "string",
                    "number"
                  ]
                },
                "practical_note": {
                  "type": "string",
                  "minLength": 10
                },
                "time_guard": {
                  "type": "string",
                  "minLength": 5
                },
                "verify": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "places": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "name",
          "map_url"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "enum": [
              "sight",
              "restaurant",
              "hotel",
              "market",
              "experience",
              "transport"
            ]
          },
          "name": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "map_url": {
            "type": "string"
          },
          "source_url": {
            "type": "string"
          },
          "hours": {
            "type": "string"
          },
          "price": {
            "type": "string"
          },
          "verify": {
            "type": "boolean"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "food_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "city",
          "category",
          "title",
          "items"
        ],
        "properties": {
          "city": {
            "type": "string"
          },
          "category": {
            "enum": [
              "专程老店",
              "夜市小吃",
              "连锁兜底"
            ]
          },
          "title": {
            "type": "string"
          },
          "items": {
            "type": "array"
          }
        }
      }
    },
    "checklists": {
      "type": "object",
      "required": [
        "essentials",
        "confirm_ahead",
        "companion_votes"
      ],
      "properties": {
        "essentials": {
          "type": "array"
        },
        "confirm_ahead": {
          "type": "array"
        },
        "companion_votes": {
          "type": "array"
        }
      }
    },
    "sources": {
      "type": "array"
    }
  }
}
